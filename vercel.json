{
  "regions": ["dub1"],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)docs' ':(exclude)scripts' ':(exclude).github' ':(exclude)supabase' ':(exclude)ml' ':(exclude)runs' ':(exclude)*.md'",
  "crons": [
    {
      "path": "/api/recalcul-stats",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/monthly-badge",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/wrap-mensuel",
      "schedule": "0 9 2 * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/streak-warning",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/popularity-digest",
      "schedule": "0 18 * * 0"
    },
    {
      "path": "/api/cron/winback",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/weekly-recap",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/pronos-resolve",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/contest/tick",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sports-birthday",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/trade-expiry",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/declencher-workflows?w=classement-hebdo.yml",
      "schedule": "25 5 * * 1"
    },
    {
      "path": "/api/cron/declencher-workflows?w=carte-mystere.yml",
      "schedule": "25 5 * * 3"
    },
    {
      "path": "/api/cron/declencher-workflows?w=vendredi-carte-semaine.yml",
      "schedule": "25 5 * * 5"
    },
    {
      "path": "/api/cron/sorties-produits",
      "schedule": "10 6 * * 1"
    },
    {
      "path": "/api/cron/followed-cards",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/ebay-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/ebay-fin",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/ebay-annonces",
      "schedule": "20 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(ico|png|jpg|jpeg|svg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "functions": {
    "src/app/api/**/route.ts": {
      "memory": 512
    },
    "src/app/api/discord/route.ts": {
      "memory": 1024
    },
    "src/app/api/qr-homepage/route.ts": {
      "memory": 1024
    },
    "src/app/api/team-logo/route.ts": {
      "memory": 1024
    },
    "src/app/api/detect-corners/route.ts": {
      "memory": 1024
    },
    "src/app/api/scan-card/route.ts": {
      "memory": 1024
    },
    "src/app/api/random-binder/route.ts": {
      "maxDuration": 25
    }
  }
}
