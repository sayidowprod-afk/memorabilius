<?xml version="1.0" encoding="utf-8"?>
<!-- Variante utilisée quand le lanceur alloue une cellule plus haute que le minimum
     déclaré (GalleryWidgetProvider bascule dessus via onAppWidgetOptionsChanged).
     Reste en orientation horizontale comme widget_gallery.xml (l'image fixe ~84dp
     de haut plafonne la hauteur totale) plutôt qu'un empilement vertical : une
     première version verticale (eyebrow/nom/meta/série/séparateur/stats) dépassait
     la hauteur réellement allouée par le lanceur et se faisait rogner en bas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="88dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="84dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/widget_card_shadow"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_card_image"
            android:layout_width="60dp"
            android:layout_height="84dp"
            android:layout_gravity="top|start"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_card_placeholder"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_eyebrow"
            android:text="MA GALERIE"
            android:textColor="#80B4FF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/widget_player_name"
            android:text="Ma galerie"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/widget_card_meta"
            android:text=""
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/widget_badges_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/widget_badge_rc"
                android:text="RC"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="@drawable/widget_badge_rc"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/widget_badge_auto"
                android:text="AUTO"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="@drawable/widget_badge_auto"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginStart="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/widget_badge_patch"
                android:text="PATCH"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="@drawable/widget_badge_patch"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginStart="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_stats"
            android:text="0 cartes"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:text="›"
        android:textColor="#80B4FF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp" />
</LinearLayout>
