<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="82dp">

        <!-- Ombre portée décalée derrière la carte : le conteneur (60x82) est un peu
             plus grand que l'image (56x78), donc l'ancrer bottom|end décale naturellement
             l'ombre de 4dp en diagonale sans marge négative (peu fiable en RemoteViews).
             ImageView et non View brute : RemoteViews a une liste blanche de classes
             inflables et rejette android.view.View ("Class not allowed to be inflated"). -->
        <ImageView
            android:layout_width="56dp"
            android:layout_height="78dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/widget_card_shadow"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_card_image"
            android:layout_width="56dp"
            android:layout_height="78dp"
            android:layout_gravity="top|start"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_card_placeholder"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_eyebrow"
            android:text="MA GALERIE"
            android:textColor="#80B4FF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/widget_player_name"
            android:text="Ma galerie"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/widget_stats"
            android:text="0 cartes"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:text="›"
        android:textColor="#80B4FF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp" />
</LinearLayout>
