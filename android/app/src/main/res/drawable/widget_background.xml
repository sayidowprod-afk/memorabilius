<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Dégradé plus profond (marine → bleu de marque) qu'un simple bleu clair à bleu
         foncé plat — donne de la matière au lieu d'un aplat générique. -->
    <gradient
        android:angle="135"
        android:startColor="#0B1E4D"
        android:centerColor="#0F3FA8"
        android:endColor="#1E63E0"
        android:type="linear" />
    <corners android:radius="22dp" />
</shape>
