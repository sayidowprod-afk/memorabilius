<?xml version="1.0" encoding="utf-8"?>
<!-- Fait tourner la carte en continu pendant le splash. L'API SplashScreen
     appelle .start() automatiquement sur ce drawable au demarrage (reconnu
     Animatable), pas de code Java/Kotlin necessaire. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_card_vector">
    <target android:name="card_group">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:duration="1400"
                android:repeatCount="infinite"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>
</animated-vector>
